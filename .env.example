# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# Google Gemini API - keys are rotated in order when one hits its rate limit
# GEMINI_API_KEY_1 is required, _2 and _3 are optional (leave blank if unused)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Optional safety / usage tuning - uncomment to change (defaults live in settings.py)
# MAX_MESSAGES_PER_DAY=8
# MIN_MINUTES_BETWEEN_MESSAGES=20
# MAX_SEARCHES_PER_HOUR=16
# MAX_DETAIL_VIEWS_PER_HOUR=12
# ACTIVE_START_HOUR=7
# ACTIVE_END_HOUR=1
# GEMINI_DAILY_CALLS_PER_KEY=400
# OUTREACH_DRY_RUN=false
# EBAY_COMPS=true
# DAILY_SUMMARY_HOUR=21
